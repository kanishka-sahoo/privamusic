DASHBOARD_USER=social@ksahoo.com
# deploy.sh generates these when .env does not exist. Do not use example secrets.
DASHBOARD_PASSWORD=
SESSION_SECRET=
DASHBOARD_PORT=18780
NAVIDROME_PORT=4533
BIND_ADDRESS=127.0.0.1
# Existing authenticated SpotiFLAC Next application-data directory:
# NEXT_SESSION_DIR=/absolute/path/to/spotiflac-next
# Optional separate password for an existing Navidrome account:
# NAVIDROME_PASSWORD=

# Optional: expose each service on your tailnet under its own hostname, e.g.
# https://privamusic.<tailnet>.ts.net and https://navidrome-privamusic.<tailnet>.ts.net.
# Needs MagicDNS and HTTPS certificates enabled for the tailnet, and a reusable auth key
# (Tailscale admin console > Settings > Keys). The tailnet name is discovered at runtime.
# COMPOSE_PROFILES=tailnet
# TS_AUTHKEY=tskey-auth-...
# DASHBOARD_TAILNET_HOSTNAME=privamusic
# NAVIDROME_TAILNET_HOSTNAME=navidrome-privamusic
# Or point the dashboard's library link at any address you expose Navidrome on:
# NAVIDROME_PUBLIC_URL=https://music.example.com/
