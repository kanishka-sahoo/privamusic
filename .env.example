DASHBOARD_USER=admin@example.com
# deploy.sh generates these when .env does not exist. Do not use example secrets.
DASHBOARD_PASSWORD=
SESSION_SECRET=
DASHBOARD_PORT=18780
NAVIDROME_PORT=4533
BIND_ADDRESS=127.0.0.1
# Existing authenticated SpotiFLAC Next application-data directory:
# NEXT_SESSION_DIR=/absolute/path/to/spotiflac-next
# Optional separate password for an existing Navidrome account:
# NAVIDROME_PASSWORD=

# Optional: expose the dashboard and Navidrome as Tailscale Services, e.g.
# https://privamusic.<tailnet>.ts.net and https://navidrome.<tailnet>.ts.net. Requirements in README:
# a tag for the host node, a reusable auth key issued for that tag, and policy grants for the services.
# COMPOSE_PROFILES=tailnet
# TS_AUTHKEY=tskey-auth-...
# TAILNET_NODE_NAME=privamusic-host
# DASHBOARD_SERVICE_NAME=privamusic
# NAVIDROME_SERVICE_NAME=navidrome
# Or point the dashboard's library link at any address you expose Navidrome on:
# NAVIDROME_PUBLIC_URL=https://music.example.com/
